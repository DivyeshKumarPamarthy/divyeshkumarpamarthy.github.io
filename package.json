{
  "name": "divyeshkumarpamarthy.github.io",
  "private": true,
  "version": "1.0.0",
  "description": "Portfolio of Divyesh Kumar Pamarthy: scroll-to-solve Rubik's cube intro built with three.js.",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2020,safari15 --legal-comments=eof --outfile=assets/js/main.js",
    "watch": "esbuild src/main.js --bundle --format=iife --target=es2020,safari15 --sourcemap --outfile=assets/js/main.js --watch",
    "serve": "python3 -m http.server 8080"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "three": "0.186.1"
  }
}
